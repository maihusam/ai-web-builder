NODE_ENV=development
# MongoDB connection string, include the database name at the end
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-web-builder
DATABASE_URL=
# Long random string used to sign login tokens
JWT_SECRET=
AI_API_KEY=
AI_MODEL=
# Frontend URL, used in password reset links
CLIENT_URL=http://localhost:5173
# Optional. Without these, password reset links are printed to the server console.
RESEND_API_KEY=
MAIL_FROM=
